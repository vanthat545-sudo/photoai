+/// An outlying landmark must not disable the missing-eye safety band.
+/// Reject it rather than clipping it into a plausible-looking eye rectangle.
+fn plausible_eye(face: Rect, eye: Rect) -> bool {
+    if eye.is_empty() || eye.x0 < face.x0 || eye.y0 < face.y0
+        || eye.x1 > face.x1 || eye.y1 > face.y1 { return false; }
+    let w = face.width().max(1) as f64;
+    let h = face.height().max(1) as f64;
+    let cx = ((eye.x0 as f64 + eye.x1 as f64) * 0.5 - face.x0 as f64) / w;
+    let cy = ((eye.y0 as f64 + eye.y1 as f64) * 0.5 - face.y0 as f64) / h;
+    (0.05..=0.95).contains(&cx) && (0.10..=0.65).contains(&cy)
+        && eye.width() as f64 / w <= 0.50
+        && eye.height() as f64 / h <= 0.35
+}
