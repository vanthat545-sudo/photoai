+fn photo_ai_router_mark(ui: &egui::Ui, rect: Rect) {
+    let id = egui::Id::new("photo-ai-router-mark-texture");
+    let cached = ui.ctx().data(|d| d.get_temp::<egui::TextureHandle>(id));
+    let texture = cached.or_else(|| {
+        let bytes = include_bytes!("../../../assets/icons/ai-router-hacker-3d.png");
+        let decoded = photocraft_codecs::decode(bytes).ok()?;
+        let rgba = decoded.convert(photocraft_codecs::ChannelLayout::Rgba, photocraft_codecs::SampleType::U8);
+        let size = [rgba.width() as usize, rgba.height() as usize];
+        let image = egui::ColorImage::from_rgba_unmultiplied(size, rgba.data());
+        let texture = ui.ctx().load_texture("photo-ai-router-mark", image, egui::TextureOptions::LINEAR);
+        ui.ctx().data_mut(|d| d.insert_temp(id, texture.clone()));
+        Some(texture)
+    });
+    if let Some(texture) = texture {
+        ui.painter().image(texture.id(), rect,
+            Rect::from_min_max(pos2(0.0, 0.0), pos2(1.0, 1.0)), Color32::WHITE);
+    }
+}
